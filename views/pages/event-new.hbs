<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-3"><i class="bi bi-calendar-plus me-2"></i>Create Event</h4>

                {{#if error}}
                <div class="alert alert-danger">{{error}}</div>
                {{/if}}

                <form action="/events" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Event Title</label>
                        <input type="text" name="title" class="form-control" value="{{form.title}}" placeholder="e.g. Office Party" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (optional)</label>
                        <textarea name="description" class="form-control" rows="2">{{form.description}}</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Event Date</label>
                        <input type="date" name="event_date" class="form-control" value="{{form.event_date}}" required>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/" class="btn btn-outline-secondary w-50">Cancel</a>
                        <button type="submit" class="btn btn-primary w-50">Create Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
