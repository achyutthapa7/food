<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="mb-0">All Events</h3>
    <a href="/events/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New Event</a>
</div>

{{#if events.length}}
<div class="row g-3">
    {{#each events}}
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm event-card">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title mb-0">{{this.title}}</h5>
                    <span class="badge text-bg-secondary">{{formatDate this.event_date}}</span>
                </div>
                {{#if this.description}}
                <p class="text-muted small mb-3">{{this.description}}</p>
                {{/if}}
                <div class="row text-center g-2 mb-3 mt-auto">
                    <div class="col-6">
                        <div class="stat-box">
                            <div class="stat-value">{{this.total_participants}}</div>
                            <div class="stat-label">Participants</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box">
                            <div class="stat-value">Rs {{formatMoney this.total_actual}}</div>
                            <div class="stat-label">Total Amount</div>
                        </div>
                    </div>
                </div>
                <a href="/events/{{this.id}}" class="btn btn-outline-primary w-100">
                    <i class="bi bi-eye me-1"></i>View
                </a>
            </div>
        </div>
    </div>
    {{/each}}
</div>
{{else}}
<div class="text-center py-5 text-muted">
    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
    No events yet. <a href="/events/new">Create one</a> to get started.
</div>
{{/if}}
