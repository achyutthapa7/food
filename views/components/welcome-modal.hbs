<div id="welcomeOverlay" class="welcome-overlay d-none">
    <div class="welcome-card card shadow-lg">
        <div class="card-body text-center p-4 p-md-5">
            <h2 class="mb-2">Welcome 👋</h2>
            <p class="text-muted mb-4">Please enter your name</p>
            <input type="text" id="welcomeNameInput" class="form-control form-control-lg mb-3 text-center" placeholder="Your name" maxlength="50">
            <div id="welcomeError" class="text-danger small mb-2 d-none">Please enter your name.</div>
            <button id="welcomeContinueBtn" class="btn btn-primary btn-lg w-100">Continue</button>
        </div>
    </div>
</div>
